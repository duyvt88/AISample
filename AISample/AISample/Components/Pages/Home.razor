@page "/"
@rendermode InteractiveServer

@using System.Text
@using Microsoft.Extensions.AI
@inject IJSRuntime JS
@inject IChatClient client
@using PDFtoImage
@using SkiaSharp

<PageTitle>AI Assistant</PageTitle>

<h1>AI Assistant</h1>

<div id="messContent">
    @foreach (var message in messages)
    {
        <div class="@message.Role">
            <b>@message.Role:</b> @message.Content
        </div>
    }
    @answer.ToString()
</div>

<div>
    <InputFile OnChange="InputFileChange" accept="image/png, image/gif, image/jpeg, application/pdf" /> <button class="btn btn-primary" @onclick="UploadFile">Upload</button>
    <div>@uploadMessage</div>
    <div class="mt-1">
        <input class="ipQuestion" @bind="message" @onkeyup="HandleKeyUp" placeholder="Type your message here..." /> <button @onclick="SendMessage" class="btn btn-primary">Send Message</button>
    </div>    
</div>

<script type="text/javascript">
    window.scrollToBottom = function (id) {
        const el = document.getElementById(id);
        if (el) el.scrollTop = el.scrollHeight;
    };
</script>

@code {
    private string message { get; set; } = string.Empty;
    private StringBuilder answer { get; set; } = new();
    private List<Message> messages { get; set; } = new List<Message>();
    List<ChatMessage> chatHistory = [];

    private IBrowserFile browserFile;
    private string uploadMessage { get; set; } = string.Empty;
    private byte[]? _attByte;
    private string _attType = string.Empty;


    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendMessage();
        }
    }

    private async Task SendMessage()
    {
        if (!string.IsNullOrWhiteSpace(message))
        {
            messages.Add(new Message { Role = "User", Content = message });
            if (_attByte != null)
            {
                chatHistory.Add(new ChatMessage(ChatRole.User, new AIContent[] { new TextContent(message), new DataContent(_attByte, _attType) }));
            }
            else
            {
                chatHistory.Add(new ChatMessage(ChatRole.User, message));
            }

            message = string.Empty;

            answer.Append("Thinking ...");
            StateHasChanged();
            await JS.InvokeVoidAsync("scrollToBottom", "messContent");

            // Stream response
            var updates = new List<ChatResponseUpdate>();
            await foreach (ChatResponseUpdate update in
                client.GetStreamingResponseAsync(chatHistory))
            {
                updates.Add(update);

                if (answer.ToString() == "Thinking ...") answer.Clear();
                answer.Append(update.Text);

                // Update UI immediately
                await InvokeAsync(StateHasChanged);
                await JS.InvokeVoidAsync("scrollToBottom", "messContent");
            }

            // Add streamed response to history
            chatHistory.AddMessages(updates);
            messages.Add(new Message { Role = "Assistant", Content = answer.ToString() });

            answer.Clear();

            await InvokeAsync(StateHasChanged);
        }        
    }

    private void InputFileChange(InputFileChangeEventArgs e)
    {
        browserFile = e.File;
        uploadMessage = string.Empty; // Clear previous messages
    }

    private async Task UploadFile()
    {
        if (browserFile != null && browserFile.Size > 0)
        {
            try
            {
                using var memoryStream = new MemoryStream();
                await browserFile.OpenReadStream(1024 * 1024 * 10).CopyToAsync(memoryStream);
                if (browserFile.ContentType == "application/pdf")
                {
                    var pngImages = ConvertPdfToPng(memoryStream);
                    if (pngImages.Count > 0)
                    {
                        _attByte = pngImages[0];
                        _attType = "image/png";
                        uploadMessage = "File uploaded successfully!";
                    }
                    else
                    {
                        uploadMessage = "Could not execute the pdf file. Please try again or upload a different file.";
                    }
                }
                else
                {                    
                    _attByte = memoryStream.ToArray();
                    _attType = browserFile.ContentType;
                    uploadMessage = "File uploaded successfully!";
                }                
                StateHasChanged();
            }
            catch (Exception ex)
            {
                uploadMessage = "An error occurred: " + ex.Message;
            }
        }
        else
        {
            uploadMessage = "Please select a file to upload.";
        }
    }

    private List<byte[]> ConvertPdfToPng(Stream pdfStream)
    {
        var pngImages = new List<byte[]>();

        // Thiết lập các thuộc tính render (DPI càng cao ảnh càng nét)
        // RenderOptions là một 'record struct' nên khai báo dạng constructor/init
        var options = new RenderOptions { Dpi = 150 };

        // Conversion.ToImages sẽ trả về một chuỗi các SKBitmap (từ SkiaSharp)
        foreach (var bitmap in Conversion.ToImages(pdfStream, options: options))
        {
            using (bitmap) // Giải phóng tài nguyên bitmap sau khi xử lý xong
            using (var memoryStream = new MemoryStream())
            {
                // Sử dụng SkiaSharp để encode trực tiếp bitmap thành định dạng PNG chất lượng 100%
                bitmap.Encode(memoryStream, SKEncodedImageFormat.Png, 100);
                
                pngImages.Add(memoryStream.ToArray());
            }
        }

        return pngImages;
    }

    private class Message
    {
        public string Role { get; set; } = string.Empty;
        public string Content { get; set; } = string.Empty;
    }
}