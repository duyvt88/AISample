@page "/RAG"
@rendermode InteractiveServer

@using System.Text
@using Microsoft.Extensions.AI
@using CommunityToolkit.VectorData.InMemory
@using AISample.DataModel
@inject IChatClient client
@inject IEmbeddingGenerator<string, Embedding<float>> generator

<PageTitle>RAG & Semantic Search</PageTitle>

<h1>RAG & Semantic Search</h1>

<b>Local movies data</b>
<table class="mt-2">
    @foreach (var movie in movieList)
    {
        <tr>            
            <td>@movie.Title</td>
            <td>@movie.Description</td>
        </tr>
    }
</table>

<div class="mt-3 mb-2">
    <input class="ipQuestion" @bind="question" @onkeyup="HandleKeyUp" placeholder="Movie title or description..." />
</div>

@if (!string.IsNullOrEmpty(question))
{
    <b>Result from Local movies data</b>
    <table class="mt-2 mb-3">
        @foreach (var movie in movieRs)
        {
            <tr>
                <td>@movie.Title</td>
                <td>@movie.Description</td>
            </tr>
        }
    </table>

    <b>Result from AI model data</b>
    <div>@answer.ToString()</div>
}

@code {
    private string question { get; set; } = string.Empty;
    private StringBuilder answer { get; set; } = new();

    List<Movie<string>> movieList = new List<Movie<string>>();
    List<Movie<string>> movieRs = new List<Movie<string>>();    

    // Vector store
    InMemoryVectorStore vectorStore = new InMemoryVectorStore();
    InMemoryCollection<string, MovieVectorRecord> collection;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // execute conditionally for loading data, otherwise this will load
        // every time the page refreshes
        if (firstRender)
        {
            movieList = MovieFactory<string>.GetMovieList();

            collection = vectorStore.GetCollection<string, MovieVectorRecord>("movies");
            await collection.EnsureCollectionExistsAsync();

            // Embed each movie description and upsert it into the collection.
            foreach (var movie in movieList)
            {
                var embedding = await generator.GenerateVectorAsync(movie.Description!);
                await collection.UpsertAsync(new MovieVectorRecord
                {
                    Key = movie.Key,
                    Title = movie.Title!,
                    Description = movie.Description!,
                    Embedding = embedding
                });
            }

            StateHasChanged();
        }
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {       

        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(question))
        {
            answer.Append("Thinking ...");
            StateHasChanged();

            var queryEmbedding = await generator.GenerateVectorAsync(question);            
            await foreach (var result in collection.SearchAsync(queryEmbedding, top: 3).Where(r => r.Score > 0.6))
            {
                movieRs.Add(new Movie<string>() { Title = result.Record.Title, Description = result.Record.Description });
                StateHasChanged();
            }

            var response = await client.GetResponseAsync(question);
            answer.Clear();
            answer.Append(response.Text);
            StateHasChanged();
        }
    }
    
}